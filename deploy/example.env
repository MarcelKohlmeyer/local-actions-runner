# Copy to .env next to compose.yml and fill in the values

# Repository the runners register for
REPO=<OWNER>/<REPO>
# Used to request runner registration tokens for REPO
TOKEN=<Github PAT with full repo access>
# Number of runner containers to start
REPLICA_COUNT=<COUNT>

# Optional: idle deep clean, see README.md (defaults shown)
# Clean only while the disk holding /var/lib/docker is fuller than this (percent)
CLEANUP_THRESHOLD=70
# Seconds between checks
CLEANUP_INTERVAL=300
# Checkouts in _work may be removed once nothing touched them for this many hours
CLEANUP_CHECKOUT_HOURS=24
